{
  "manifest_version": 3,
  "name": "HospedaMais Booking Connector",
  "version": "0.3.4",
  "description": "Captura reservas visíveis na Extranet da Booking e envia ao HospedaMais, com modo automático opcional e deduplicação.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://admin.booking.com/*",
    "https://*.supabase.co/functions/v1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HospedaMais Booking Connector"
  },
  "content_scripts": [
    {
      "matches": ["https://admin.booking.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
